# Groq API (required) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq API model for NL2SQL / Data Intelligence (e.g. GPT OSS 120B)
GROQ_MODEL=openai/gpt-oss-120b

# Lighter model for heal-loop agents (avoids GPT OSS 120B 8k TPM limits)
GROQ_AGENT_MODEL=llama-3.1-8b-instant

# LangSmith observability (required for assignment screenshot)
# Sign up free: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sentinel-v2
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Paths (defaults work out of the box)
# DB_PATH=data/system_telemetry.db
# KB_PATH=data/knowledge_base